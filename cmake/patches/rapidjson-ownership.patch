         }
         else
             SetElementsPointer(0);
@@ -2050,12 +2049,12 @@ RAPIDJSON_DIAG_POP
         if (count) {
             Member* m = static_cast<Member*>(allocator.Malloc(count * sizeof(Member)));
             SetMembersPointer(m);
